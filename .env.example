# Advanced Professional Suite Configuration

# App Settings
APP_NAME="Advanced Professional Suite"
APP_VERSION="1.0.0"

# Server
HOST=127.0.0.1
PORT=8000

# Upload Limits
PDFSMITH_MAX_MB=50
MAX_FILES_PER_REQUEST=20

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60

# Performance
MAX_WORKERS=4

# Features
ALLOW_AI_TOOLS=true

# CORS (use specific origins in production)
CORS_ORIGINS=*

# AI Tools (optional)
# ANTHROPIC_API_KEY=your_key_here
# PDFSMITH_AI_MODEL=claude-opus-4-8

# Job Queue (for scaling - optional)
JOBS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# Storage (memory or s3)
STORAGE_BACKEND=memory
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=
# S3_ENDPOINT_URL=
